# Database and authentication
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Choose one: openrouter, groq, google, or local.
# Netlify cannot reach a model running on your laptop, so use a cloud provider there.
AI_PROVIDER="openrouter"

# Zero-cloud-key local adapter (the app does not download or start a model).
LOCAL_LLM_BASE_URL="http://127.0.0.1:1234/v1"
LOCAL_LLM_MODEL="local-model"
LOCAL_LLM_API_KEY="local"

# Optional cloud providers. Configure only on the server.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.1-8b-instant"
GOOGLE_AI_API_KEY=""
GOOGLE_AI_MODEL="gemini-2.5-flash-lite"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-3-flash-preview"
